FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/flight ./cmd/flight

FROM alpine:3.21
RUN adduser -D -u 10001 app && apk add --no-cache ca-certificates
COPY --from=build /out/flight /usr/local/bin/flight
USER app
ENTRYPOINT ["/usr/local/bin/flight"]
