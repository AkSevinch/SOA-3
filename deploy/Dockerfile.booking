FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/booking ./cmd/booking

FROM alpine:3.21
RUN adduser -D -u 10001 app && apk add --no-cache ca-certificates
COPY --from=build /out/booking /usr/local/bin/booking
USER app
ENTRYPOINT ["/usr/local/bin/booking"]
